{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/article.js": { "maxDuration": 60 },
    "api/news.js": { "maxDuration": 30 },
    "api/stock-news.js": { "maxDuration": 20 }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|src/|@|node_modules/|.*\\.(?:js|mjs|jsx|ts|tsx|css|map|json|svg|png|jpg|jpeg|gif|ico|webp|woff|woff2|ttf|eot)$).*)",
      "destination": "/index.html"
    }
  ]
}
